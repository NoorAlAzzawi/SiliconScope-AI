# SiliconScope AI — backend environment configuration
# Copy this file to .env and fill in the values. Never commit .env.
#
# .env is excluded from version control (.gitignore: .env.*).
# This file is version-controlled and contains only placeholders.

# ── Database ──────────────────────────────────────────────────────────────────
# PostgreSQL connection string for the application account (sscope_app).
# The sscope_app role must already exist (run migrations/000_create_roles.sql)
# and must have a password set before starting the backend.
#
# Format: postgres://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=postgres://sscope_app:REPLACE_WITH_STRONG_PASSWORD@localhost:5432/sscope

# ── Dashboard authentication ──────────────────────────────────────────────────
# bcrypt hash (cost 12) of the dashboard password.
# The backend reads this at startup, hashes it for comparison, and never logs
# the plaintext value. If unset, POST /dashboard/login returns HTTP 503.
#
# Generate a hash:
#   node -e "const b=require('bcryptjs');b.hash('your-password',12).then(h=>console.log(h))"
SSCOPE_DASHBOARD_PASSWORD=

# ── Server ────────────────────────────────────────────────────────────────────
# TCP port the backend listens on. Default: 3000.
PORT=3000
